(version 1)
(rule isolation_gap
  (constraint clearance (min 2mm))
  (condition "(A.NetClass == 'GND_prim' || A.NetClass == '5V_prim' || A.NetClass == 'Coil_POWER' || A.NetClass == '3V3_LOGIC_prim') && (B.NetClass == 'GND_isolated' || B.NetClass == '5V_isolated' || B.NetClass == 'Rail_POWER' || B.NetClass == 'ADC_ANALOG' || B.NetClass == '3V3_LOGIC_isolated') && !A.insideArea('barrier_parts') && !B.insideArea('barrier_parts')"))
